# API da escola (portal). Sem esta variável o site usa https://api.escolacafeidiomas.com.br
# Dev local: VITE_API_URL=http://localhost:3333
VITE_API_URL=

# Cloudflare Turnstile (anti-robô) no formulário de contato. Vazio = desligado.
# Anda junto com TURNSTILE_SECRET_KEY na API: chave só na API = todo envio recusado.
VITE_TURNSTILE_SITE_KEY=
