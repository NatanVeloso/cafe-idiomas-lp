{
  "rewrites": [
    {
      "source": "/ingles",
      "destination": "/ingles/index.html"
    },
    {
      "source": "/ingles/",
      "destination": "/ingles/index.html"
    },
    {
      "source": "/frances",
      "destination": "/frances/index.html"
    },
    {
      "source": "/frances/",
      "destination": "/frances/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/logo.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/og-image.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}